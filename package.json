{
  "name": "bilibili-memory",
  "description": "本地永久保存 B 站观看历史、收藏夹、订阅合集、关注列表与点赞/投币记录，并在内容查不到时留下完整快照，防止无从追溯。",
  "private": true,
  "version": "0.3.1",
  "author": "Otiosum-coder",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Otiosum-coder/bilibili-memory.git"
  },
  "homepage": "https://github.com/Otiosum-coder/bilibili-memory#readme",
  "bugs": {
    "url": "https://github.com/Otiosum-coder/bilibili-memory/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "wxt --mode development",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt --mode production zip",
    "zip:firefox": "wxt --mode production zip -b firefox",
    "test": "vitest run",
    "compile": "tsc --noEmit",
    "hname:build": "node tools/hname-build.mjs",
    "check:private-data": "node tools/hname-guard.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@types/howler": "^2.2.12",
    "axios": "^1.9.0",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.13",
    "howler": "^2.2.4",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hot-toast": "^2.5.2",
    "react-router-dom": "^7.6.0",
    "use-debounce": "^10.0.4",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.3",
    "@wxt-dev/module-react": "^1.1.3",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "3",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11",
    "wxt": "^0.20.6"
  }
}
